<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>飛来くん - VHS DODGE</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#000000">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="飛来くん">
<link rel="apple-touch-icon" href="icon-192.png">
<link rel="icon" href="icon-192.png">
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<style>
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none; -webkit-user-select:none; touch-action:none; }
  /* iOS Safari auto-zooms into any input/textarea/select with font-size below 16px on focus,
     regardless of the viewport meta tag - keep all of them at >=16px to prevent that. */
  input, textarea, select { font-size:16px; touch-action:manipulation; }
  html,body { width:100%; height:100%; background:#000; overflow:hidden; font-family:'Courier New', monospace; }

  #stage {
    position:relative; width:100%; height:100%;
    max-width:520px; max-height:920px; margin:0 auto;
    background:#111; overflow:hidden;
    filter:contrast(1.08) saturate(1.05);
  }
  #bg {
    position:absolute; inset:0;
    background-image:url('data:image/jpeg;base64,');
    background-size:cover; background-position:center 25%;
    filter:brightness(0.88) blur(0px);
  }
  #vignette {
    position:absolute; inset:0;
    background:radial-gradient(ellipse at center, rgba(0,0,0,0) 40%, rgba(0,0,0,0.5) 100%);
    pointer-events:none; z-index:25;
  }
  #scanlines {
    position:absolute; inset:0;
    background:repeating-linear-gradient(to bottom, rgba(0,0,0,0.18) 0px, rgba(0,0,0,0.18) 1px, rgba(0,0,0,0) 2px, rgba(0,0,0,0) 3px);
    mix-blend-mode:multiply; pointer-events:none; opacity:0.55; z-index:26;
  }
  #noise {
    position:absolute; inset:0; pointer-events:none; opacity:0.06; z-index:27;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    animation:noiseshift 0.2s steps(2) infinite;
  }
  @keyframes noiseshift { 0%{transform:translate(0,0)} 50%{transform:translate(-2%,1%)} 100%{transform:translate(1%,-2%)} }

  #hud {
    position:absolute; top:14px; left:14px; right:14px;
    display:flex; justify-content:space-between;
    color:#e8e8e8; font-size:13px; letter-spacing:1px;
    text-shadow:0 0 4px rgba(0,0,0,0.9);
    pointer-events:none; z-index:40;
  }
  #rec { display:flex; align-items:center; gap:6px; }
  #recdot { width:10px; height:10px; border-radius:50%; background:#e0201c; animation:blink 1s steps(1) infinite; box-shadow:0 0 6px #e0201c; }
  @keyframes blink { 0%,49%{opacity:1} 50%,100%{opacity:0.15} }

  #score {
    position:absolute; bottom:16px; left:0; right:0; text-align:center;
    color:#e8e8e8; font-size:13px; letter-spacing:2px;
    text-shadow:0 0 4px rgba(0,0,0,0.9); z-index:40; pointer-events:none;
  }

  #lanes { position:absolute; inset:0; z-index:10; }
  .giant-obj {
    position:absolute; top:-15%; width:70px;
    transform:translate(-50%,0) scale(0.15);
    pointer-events:none;
    filter:brightness(0.95) contrast(1.08);
    will-change:transform,top,opacity;
  }
  .giant-obj img { width:100%; display:block; }
  .giant-obj.giant-special img { filter:brightness(0.75) contrast(1.15) drop-shadow(0 0 14px rgba(255,215,80,0.9)); }
  .giant-special-label {
    position:absolute; top:-22px; left:50%; transform:translateX(-50%);
    white-space:nowrap; font-size:11px; letter-spacing:0.5px; color:#ffd23b;
    text-shadow:0 0 6px rgba(0,0,0,0.9), 0 0 10px rgba(255,210,59,0.6);
    pointer-events:none;
  }

  #player {
    position:absolute; bottom:10%; width:46px; height:22px;
    left:50%; transform:translate(-50%,0);
    z-index:20; pointer-events:none;
    transition:left 0.16s cubic-bezier(.3,.9,.3,1);
  }
  #player .shadow {
    width:100%; height:100%;
    background:radial-gradient(ellipse at center, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0) 75%);
  }
  #player .mark {
    position:absolute; left:50%; top:-6px; transform:translateX(-50%);
    width:6px; height:6px; border-radius:50%;
    background:#ffd23b; box-shadow:0 0 8px #ffd23b;
    opacity:0.85;
  }

  #laneGuides { position:absolute; inset:0; z-index:9; pointer-events:none; opacity:0.16; }
  .laneLine { position:absolute; top:0; bottom:0; width:1px; background:#fff; }

  #tapzone { position:absolute; inset:0; z-index:50; display:flex; }
  .tapHalf { flex:1; }

  #startScreen, #overScreen, #rankScreen, #vsMenuScreen, #vsWaitScreen, #vsCountdownScreen, #vsResultScreen,
  #rkMenuScreen, #rkWaitScreen, #rkResultScreen, #collectionScreen {
    position:absolute; inset:0; background:rgba(0,0,0,0.88); color:#eee;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; padding:30px; z-index:80; gap:14px;
  }
  #overScreen, #rankScreen, #vsMenuScreen, #vsWaitScreen, #vsCountdownScreen, #vsResultScreen,
  #rkMenuScreen, #rkWaitScreen, #rkResultScreen, #rkGameScreen, #collectionScreen { display:none; }
  #rankScreen, #collectionScreen { z-index:85; overflow-y:auto; padding:40px 22px 26px; justify-content:flex-start; }
  #rankScreen, #rankScreen *, #collectionScreen, #collectionScreen * { touch-action:pan-y; }
  #vsMenuScreen, #vsWaitScreen, #vsResultScreen, #rkMenuScreen, #rkWaitScreen, #rkResultScreen { z-index:85; overflow-y:auto; }
  #vsCountdownScreen, #rkCountdownScreen { z-index:96; background:rgba(0,0,0,0.4); }

  #rkRankBadgeRow { display:flex; align-items:center; gap:12px; }
  #rkRankIconWrap { width:44px; height:44px; border-radius:50%; overflow:hidden; border:2px solid rgba(255,255,255,0.35); position:relative; flex-shrink:0; }
  #rkRankIconImg { position:absolute; top:0; left:0; height:44px; width:396px; image-rendering:auto; }
  #rkRankTextWrap { text-align:left; }
  #rkRankName { font-size:15px; color:#ffd23b; letter-spacing:1px; }
  #rkRankRP { font-size:11px; color:#999; }

  #rkResultIconWrap { width:110px; height:110px; border-radius:50%; overflow:hidden; border:3px solid rgba(255,255,255,0.4); position:relative; box-shadow:0 0 26px rgba(0,0,0,0.6); }
  #rkResultIconImg { position:absolute; top:0; left:0; height:110px; width:990px; }
  #rkResultRankName { font-size:16px; color:#ffd23b; letter-spacing:1px; }
  #rkResultRPChange { font-size:14px; }

  #rkGameScreen {
    position:absolute; inset:0; z-index:80; background:transparent; overflow:hidden;
  }
  #rkOppZone {
    position:absolute; top:0; left:0; right:0; height:42%;
    touch-action:none;
  }
  #rkMyZone {
    position:absolute; bottom:0; left:0; right:0; height:42%;
    touch-action:none;
  }
  #rkLaneGuides { position:absolute; inset:0; z-index:1; pointer-events:none; opacity:0.14; }
  #rkOppDot, #rkMyDot {
    position:absolute; width:40px; height:40px; margin-left:-20px; margin-top:-20px;
    border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-size:10px; color:#fff; text-shadow:0 0 4px rgba(0,0,0,0.9);
    transition:left 0.14s cubic-bezier(.3,.9,.3,1);
    z-index:5;
  }
  #rkMyDot { background:rgba(255,80,80,0.85); border:2px solid #fff; bottom:19%; top:auto; }
  #rkOppDot { background:rgba(80,140,255,0.85); border:2px solid #fff; top:19%; }
  #rkProjLayer { position:absolute; inset:0; z-index:4; pointer-events:none; }
  .rkProj { position:absolute; width:34px; height:auto; margin-left:-17px; margin-top:-38px; filter:brightness(0.65) contrast(1.15); pointer-events:none; }
  #rkOppHud, #rkMyHud {
    position:absolute; left:0; right:0; text-align:center;
    z-index:6; pointer-events:none; display:flex; justify-content:center;
    align-items:baseline; gap:8px;
  }
  #rkOppHud { top:14px; }
  #rkMyHud { bottom:10px; }
  .rkHpLabel {
    font-size:11px; letter-spacing:1px; color:rgba(255,255,255,0.75);
    text-shadow:0 0 4px rgba(0,0,0,0.9);
    max-width:110px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  }
  .rkHearts { font-size:18px; letter-spacing:4px; text-shadow:0 0 4px rgba(0,0,0,0.9); }
  #rkFireHint {
    position:absolute; top:6px; right:10px; font-size:10px; color:rgba(255,255,255,0.55);
    z-index:6; pointer-events:none;
  }

  #collectionGrid {
    display:grid; grid-template-columns:1fr 1fr; gap:14px;
    width:100%; max-width:340px; margin-top:6px;
  }
  .collCard {
    background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.15);
    border-radius:8px; padding:12px 8px; display:flex; flex-direction:column;
    align-items:center; gap:6px;
  }
  .collCard img {
    width:64px; height:64px; object-fit:contain; object-position:center top;
  }
  .collCard .collSilhouette {
    width:64px; height:64px; border-radius:6px; background:#000;
    display:flex; align-items:center; justify-content:center;
    font-size:22px; color:rgba(255,255,255,0.3);
  }
  .collCard .collName { font-size:11px; letter-spacing:0.5px; }
  .collCard .collOdds { font-size:9px; color:#777; }
  .collCard.locked .collName { color:#666; }

  #discoveryToast {
    position:absolute; left:50%; top:18%; transform:translate(-50%,-10px);
    background:rgba(0,0,0,0.85); border:1px solid rgba(255,215,80,0.6);
    color:#ffd23b; padding:12px 20px; border-radius:8px;
    font-size:13px; letter-spacing:0.5px; text-align:center;
    z-index:98; opacity:0; pointer-events:none;
    transition:opacity 0.4s ease, transform 0.4s ease;
    box-shadow:0 0 24px rgba(255,215,80,0.35);
    max-width:280px;
  }
  #discoveryToast.show { opacity:1; transform:translate(-50%,0); }

  .title { font-size:25px; letter-spacing:3px; color:#ff2a2a; text-shadow:0 0 12px rgba(255,0,0,0.7); }
  .sub { font-size:13px; line-height:1.75; color:#ccc; max-width:340px; }
  .btn {
    padding:12px 28px; background:#ff2a2a; color:#111;
    font-weight:bold; letter-spacing:2px; border:none; border-radius:4px;
    font-family:inherit; font-size:14px; box-shadow:0 0 16px rgba(255,0,0,0.5);
    pointer-events:auto; cursor:pointer;
  }
  .btn.secondary { background:transparent; color:#eee; border:1px solid rgba(255,255,255,0.5); box-shadow:none; }
  .btn.small { padding:9px 18px; font-size:12px; }
  .btnRow { display:flex; gap:10px; flex-wrap:wrap; justify-content:center; }

  #jumpscare {
    position:absolute; inset:0; z-index:90; display:flex; align-items:flex-end; justify-content:center;
    overflow:hidden; opacity:0; pointer-events:none;
  }
  #jumpscare img { width:230%; transform:translateY(5%); filter:brightness(0.7) contrast(1.3) saturate(1.2); }
  #redflash { position:absolute; inset:0; background:#ff0000; opacity:0; z-index:95; pointer-events:none; }
  #scoreLine { font-size:15px; color:#fff; margin-top:6px; }
  #bestLine { font-size:12px; color:#999; }

  #muteBtn {
    position:absolute; top:12px; right:14px; z-index:60;
    background:rgba(0,0,0,0.35); border:1px solid rgba(255,255,255,0.25);
    color:#eee; font-size:13px; width:30px; height:30px; border-radius:50%;
    line-height:1; cursor:pointer; pointer-events:auto;
  }
  #reloadBtn {
    position:absolute; top:12px; right:50px; z-index:60;
    background:rgba(0,0,0,0.35); border:1px solid rgba(255,255,255,0.25);
    color:#eee; font-size:13px; width:30px; height:30px; border-radius:50%;
    line-height:1; cursor:pointer; pointer-events:auto;
  }

  #rankScreen .title { font-size:20px; }
  .weekLabel { font-size:11px; color:#999; letter-spacing:1px; }
  #nameRow { display:flex; gap:8px; align-items:center; margin-top:6px; }
  #usernameInput {
    background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.35);
    color:#fff; font-family:inherit; font-size:16px; padding:8px 10px;
    border-radius:4px; width:150px; letter-spacing:1px;
  }
  #rankList {
    width:100%; max-width:340px; margin-top:8px;
    list-style:none; text-align:left;
    display:flex; flex-direction:column; gap:5px;
  }
  #rankList li {
    display:flex; justify-content:space-between;
    font-size:13px; padding:7px 10px;
    background:rgba(255,255,255,0.05);
    border-radius:4px; letter-spacing:0.5px;
  }
  #rankList li .rk { color:#ff6a4d; width:24px; flex-shrink:0; }
  #rankList li .nm { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; padding:0 6px; }
  #rankList li .tm { color:#ffd23b; }
  #rankStatus { font-size:12px; color:#888; min-height:16px; }

  #playerOpp { position:absolute; bottom:10%; width:46px; height:22px; left:50%; transform:translate(-50%,0); z-index:19; pointer-events:none; transition:left 0.16s cubic-bezier(.3,.9,.3,1); }
  #playerOpp .shadow { width:100%; height:100%; background:radial-gradient(ellipse at center, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 75%); }
  #playerOpp .mark { position:absolute; left:50%; top:-6px; transform:translateX(-50%); width:6px; height:6px; border-radius:50%; opacity:0.85; }

  #vsStatus {
    position:absolute; bottom:38px; left:0; right:0; text-align:center;
    color:#ccc; font-size:11px; letter-spacing:1px; z-index:40; pointer-events:none;
    text-shadow:0 0 4px rgba(0,0,0,0.9);
  }

  #joinRow input#roomIdInput {
    background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.35);
    color:#fff; font-family:inherit; font-size:16px; padding:8px 10px;
    border-radius:4px; width:110px; letter-spacing:4px; text-align:center;
  }
  #roomCodeDisplay {
    font-size:42px; letter-spacing:10px; color:#ffd23b;
    text-shadow:0 0 14px rgba(255,210,59,0.6);
  }
  #countdownNum {
    font-size:110px; color:#ff2a2a; text-shadow:0 0 30px rgba(255,0,0,0.8);
    font-weight:bold;
  }
  #giantFace {
    width:96px; height:96px; border-radius:50%;
    object-fit:cover; object-position:center 30%;
    border:2px solid rgba(255,42,42,0.7);
    box-shadow:0 0 22px rgba(255,42,42,0.55);
    filter:brightness(0.9) contrast(1.1);
  }
</style>
</head>
<body>

<div id="stage">
  <div id="bg"></div>
  <div id="laneGuides"></div>
  <div id="lanes"></div>
  <div id="player"><div class="shadow"></div><div class="mark"></div></div>
  <div id="playerOpp" style="display:none;"><div class="shadow"></div><div class="mark"></div></div>

  <div id="vignette"></div>
  <div id="scanlines"></div>
  <div id="noise"></div>

  <div id="hud">
    <div id="rec"><div id="recdot"></div><span>REC</span></div>
    <div id="ts">2025.10.18&nbsp;&nbsp;17:42</div>
  </div>
  <button id="muteBtn">🔊</button>
  <button id="reloadBtn" title="リロード">🔄</button>
  <div id="score">生存タイム: <span id="scoreVal">0.0</span>秒</div>
  <div id="vsStatus" style="display:none;"></div>

  <div id="jumpscare"><img src="data:image/png;base64," alt=""></div>
  <div id="redflash"></div>

  <div id="tapzone">
    <div class="tapHalf" id="tapLeft"></div>
    <div class="tapHalf" id="tapRight"></div>
  </div>

  <div id="startScreen">
    <img id="giantFace" src="data:image/jpeg;base64," alt="">
    <div class="title">飛来くん</div>
    <div class="sub">
      2025年10月18日 17:42、遊歩道。<br>
      上から巨人が降ってくる。<br><br>
      画面の左右をタップ / スワイプ / ←→キーで<br>
      レーンを移動して避け続けろ。<br>
      生き残った時間が長いほどランキング上位。<br>
      当たれば終わり。
    </div>
    <div class="btnRow">
      <button class="btn" id="startBtn">生き残る</button>
      <button class="btn secondary" id="vsBtn">対戦</button>
      <button class="btn secondary" id="rankBtn">ランキング</button>
    </div>
    <button class="btn secondary small" id="collectionBtn">コレクション</button>
    <button class="btn secondary small" id="installBtn" style="display:none;">📲 アプリとしてインストール</button>
    <div class="weekLabel" id="iosHint" style="display:none;max-width:300px;">
      iPhoneの場合: 共有ボタン →「ホーム画面に追加」でインストールできます
    </div>
  </div>

  <div id="collectionScreen">
    <div class="title">コレクション</div>
    <div class="sub">生き残るモードで、超低確率で特別な巨人が降ってくることがある。</div>
    <div id="collectionGrid"></div>
    <button class="btn secondary" id="collectionBackBtn">ホームへ戻る</button>
  </div>

  <div id="discoveryToast"></div>

  <div id="overScreen">
    <div class="title" id="overTitle">つかまった</div>
    <div class="sub">録画はここで途切れている。</div>
    <div id="scoreLine">生存時間: <span id="finalDist">0.0</span>秒</div>
    <div id="bestLine">自己ベスト: <span id="bestDist">0.0</span>秒</div>
    <div class="btnRow">
      <button class="btn" id="retryBtn">もう一度 / RETRY</button>
      <button class="btn secondary" id="overRankBtn">ランキング</button>
      <button class="btn secondary" id="overHomeBtn">ホームへ</button>
    </div>
  </div>

  <div id="rankScreen">
    <div class="title">ランキング</div>
    <div id="rankTabRow" class="btnRow">
      <button class="btn small" id="rankTabTime">タイム</button>
      <button class="btn secondary small" id="rankTabRank">ランク</button>
    </div>
    <div class="weekLabel" id="weekLabel">ランキング</div>
    <div id="nameRow">
      <input id="usernameInput" type="text" maxlength="10" placeholder="ユーザーネーム">
      <button class="btn small" id="saveNameBtn">保存</button>
    </div>
    <div id="rankStatus">読み込み中...</div>
    <ol id="rankList"></ol>
    <button class="btn secondary" id="rankBackBtn">ホームへ戻る</button>
  </div>

  <div id="vsMenuScreen">
    <div class="title">対戦モード</div>
    <div class="sub">同じ場に2人が入り、同じ配置で降ってくる巨人を避け続ける。<br>長く生き残った方の勝ち。</div>
    <button class="btn" id="randomMatchBtn">ランダムマッチ</button>
    <div class="weekLabel">— または —</div>
    <button class="btn secondary" id="createRoomBtn">ルームを作成</button>
    <div class="weekLabel">— または —</div>
    <div id="joinRow" style="display:flex; gap:8px; align-items:center;">
      <input id="roomIdInput" type="text" maxlength="6" placeholder="ルームID" style="text-transform:uppercase;">
      <button class="btn small" id="joinRoomBtn">参加する</button>
    </div>
    <div class="weekLabel">— または —</div>
    <button class="btn secondary" id="rkOpenBtn">ランクマッチ</button>
    <div id="vsMenuStatus" style="font-size:12px;color:#888;min-height:16px;"></div>
    <button class="btn secondary" id="vsMenuBackBtn">ホームへ戻る</button>
  </div>

  <div id="rkMenuScreen">
    <div class="title">ランクマッチ</div>
    <div id="rkRankBadgeRow"><div id="rkRankIconWrap"><img id="rkRankIconImg" src="data:image/jpeg;base64,"></div><div id="rkRankTextWrap"><div id="rkRankName">-</div><div id="rkRankRP">RP -</div></div></div>
    <div class="sub">相手と向かい合って戦う。<br>下半分をタップでレーン移動、上半分をタップで巨人を前方に発射。<br>相手のいるレーンに当てたら1発、2発当てたら勝ち。<br>相手が見つからない場合は少し待つとbotと対戦します。<br>ランクは1カ月ごとのシーズン制。</div>
    <button class="btn" id="rkRandomBtn">ランクマッチを探す</button>
    <div id="rkMenuStatus" style="font-size:12px;color:#888;min-height:16px;"></div>
    <button class="btn secondary" id="rkMenuBackBtn">ホームへ戻る</button>
  </div>

  <div id="rkWaitScreen">
    <div class="title">相手を探しています</div>
    <div class="weekLabel" id="rkWaitDots">.</div>
    <button class="btn secondary" id="rkCancelBtn">キャンセル</button>
  </div>

  <div id="rkCountdownScreen">
    <div id="rkCountdownNum">3</div>
  </div>

  <div id="rkGameScreen">
    <div id="rkLaneGuides"></div>
    <div id="rkOppZone"></div>
    <div id="rkMyZone"></div>
    <div id="rkProjLayer"></div>
    <div id="rkOppDot"></div>
    <div id="rkMyDot"></div>
    <div id="rkOppHud"><span class="rkHpLabel" id="rkOppNameLabel">相手</span><span class="rkHearts" id="rkOppHearts">●●</span></div>
    <div id="rkMyHud"><span class="rkHpLabel">あなた</span><span class="rkHearts" id="rkMyHearts">●●</span></div>
    <div id="rkFireHint">上タップで発射 / 下でレーン移動</div>
  </div>

  <div id="rkResultScreen">
    <div class="title" id="rkResultTitle">結果</div>
    <div id="rkResultIconWrap"><img id="rkResultIconImg" src="data:image/jpeg;base64,"></div>
    <div id="rkResultRankName">-</div>
    <div id="rkResultRPChange">-</div>
    <button class="btn secondary" id="rkResultHomeBtn">ホームへ</button>
  </div>

  <div id="vsWaitScreen">
    <div class="title">相手を待っています</div>
    <div class="sub" id="vsWaitSub">このルームIDを相手に伝えてください</div>
    <div id="roomCodeDisplay">------</div>
    <div class="weekLabel" id="vsWaitDots">.</div>
    <button class="btn secondary" id="cancelRoomBtn">キャンセル</button>
  </div>

  <div id="vsCountdownScreen">
    <div id="countdownNum">3</div>
  </div>

  <div id="vsResultScreen">
    <div class="title" id="vsResultTitle">結果待ち</div>
    <div id="vsResultBody" class="sub"></div>
    <button class="btn secondary" id="vsResultHomeBtn" style="display:none;">ホームへ</button>
  </div>
</div>

<script>
(function(){
  // ---- iOS zoom prevention (pinch-gesture + double-tap) ----
  document.addEventListener('gesturestart', e=>e.preventDefault());
  document.addEventListener('gesturechange', e=>e.preventDefault());
  document.addEventListener('gestureend', e=>e.preventDefault());
  let lastTouchEndAt = 0;
  document.addEventListener('touchend', (e)=>{
    const now = Date.now();
    if(now - lastTouchEndAt <= 300){ e.preventDefault(); }
    lastTouchEndAt = now;
  }, {passive:false});
  document.addEventListener('dblclick', e=>e.preventDefault());
  // ------------------------------------------------------------

  const stage = document.getElementById('stage');
  const lanesEl = document.getElementById('lanes');
  const player = document.getElementById('player');
  const scoreVal = document.getElementById('scoreVal');
  const startScreen = document.getElementById('startScreen');
  const overScreen = document.getElementById('overScreen');
  const startBtn = document.getElementById('startBtn');
  const retryBtn = document.getElementById('retryBtn');
  const jumpscare = document.getElementById('jumpscare');
  const redflash = document.getElementById('redflash');
  const finalDist = document.getElementById('finalDist');
  const bestDistEl = document.getElementById('bestDist');
  const tsEl = document.getElementById('ts');
  const laneGuides = document.getElementById('laneGuides');
  const rankScreen = document.getElementById('rankScreen');
  const collectionScreen = document.getElementById('collectionScreen');
  const collectionBtn = document.getElementById('collectionBtn');
  const collectionBackBtn = document.getElementById('collectionBackBtn');
  const collectionGrid = document.getElementById('collectionGrid');
  const discoveryToast = document.getElementById('discoveryToast');
  const rankBtn = document.getElementById('rankBtn');
  const overRankBtn = document.getElementById('overRankBtn');
  const overHomeBtn = document.getElementById('overHomeBtn');
  const rankBackBtn = document.getElementById('rankBackBtn');
  const usernameInput = document.getElementById('usernameInput');
  const saveNameBtn = document.getElementById('saveNameBtn');
  const rankList = document.getElementById('rankList');
  const rankStatus = document.getElementById('rankStatus');
  const rankTabTime = document.getElementById('rankTabTime');
  const rankTabRank = document.getElementById('rankTabRank');
  const playerOpp = document.getElementById('playerOpp');
  const vsStatus = document.getElementById('vsStatus');
  const vsBtn = document.getElementById('vsBtn');
  const vsMenuScreen = document.getElementById('vsMenuScreen');
  const createRoomBtn = document.getElementById('createRoomBtn');
  const randomMatchBtn = document.getElementById('randomMatchBtn');
  const roomIdInput = document.getElementById('roomIdInput');
  const joinRoomBtn = document.getElementById('joinRoomBtn');
  const vsMenuStatus = document.getElementById('vsMenuStatus');
  const vsMenuBackBtn = document.getElementById('vsMenuBackBtn');
  const vsWaitScreen = document.getElementById('vsWaitScreen');
  const roomCodeDisplay = document.getElementById('roomCodeDisplay');
  const vsWaitSub = document.getElementById('vsWaitSub');
  const vsWaitDots = document.getElementById('vsWaitDots');
  const cancelRoomBtn = document.getElementById('cancelRoomBtn');
  const vsCountdownScreen = document.getElementById('vsCountdownScreen');
  const countdownNum = document.getElementById('countdownNum');
  const vsResultScreen = document.getElementById('vsResultScreen');
  const vsResultTitle = document.getElementById('vsResultTitle');
  const vsResultBody = document.getElementById('vsResultBody');
  const vsResultHomeBtn = document.getElementById('vsResultHomeBtn');
  const installBtn = document.getElementById('installBtn');
  const iosHint = document.getElementById('iosHint');

  const LANES = [18, 50, 82]; // percent x positions
  const lineA = document.createElement('div');
  lineA.className='laneLine'; lineA.style.left = ((LANES[0]+LANES[1])/2)+'%';
  laneGuides.appendChild(lineA);
  const lineB = document.createElement('div');
  lineB.className='laneLine'; lineB.style.left = ((LANES[1]+LANES[2])/2)+'%';
  laneGuides.appendChild(lineB);

  // ---------- synthesized ambient BGM ("something approaching") ----------
  const muteBtn = document.getElementById('muteBtn');
  const reloadBtn = document.getElementById('reloadBtn');
  let audioCtx=null, master=null, droneGain=null, muted=false;
  let nextHeartAt=0, heartInterval=900;

  function ensureAudio(){
    if(audioCtx) return;
    audioCtx = new (window.AudioContext||window.webkitAudioContext)();
    master = audioCtx.createGain();
    master.gain.value = muted?0:0.75;
    master.connect(audioCtx.destination);

    droneGain = audioCtx.createGain();
    droneGain.gain.value = 0.0001;
    droneGain.connect(master);

    const lp = audioCtx.createBiquadFilter();
    lp.type='lowpass'; lp.frequency.value=220;
    lp.connect(droneGain);

    [55, 58.5].forEach(f=>{
      const o = audioCtx.createOscillator();
      o.type='sawtooth'; o.frequency.value=f;
      const g = audioCtx.createGain(); g.gain.value=0.5;
      o.connect(g); g.connect(lp);
      o.start();
    });

    const lfo = audioCtx.createOscillator();
    lfo.type='sine'; lfo.frequency.value=0.12;
    const lfoGain = audioCtx.createGain(); lfoGain.gain.value=40;
    lfo.connect(lfoGain); lfoGain.connect(lp.frequency);
    lfo.start();
  }

  function noiseBurst(dur, type, startFreq, endFreq, vol){
    if(!audioCtx || muted) return;
    const bufSize = Math.floor(audioCtx.sampleRate*dur);
    const buf = audioCtx.createBuffer(1, bufSize, audioCtx.sampleRate);
    const data = buf.getChannelData(0);
    for(let i=0;i<bufSize;i++) data[i] = (Math.random()*2-1) * (1 - i/bufSize);
    const src = audioCtx.createBufferSource();
    src.buffer = buf;
    const bp = audioCtx.createBiquadFilter();
    bp.type = type||'bandpass';
    bp.frequency.setValueAtTime(startFreq, audioCtx.currentTime);
    if(endFreq) bp.frequency.exponentialRampToValueAtTime(endFreq, audioCtx.currentTime+dur);
    bp.Q.value = 1.1;
    const g = audioCtx.createGain();
    g.gain.setValueAtTime(vol, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime+dur);
    src.connect(bp); bp.connect(g); g.connect(master);
    src.start(); src.stop(audioCtx.currentTime+dur);
  }

  function heartThump(){
    if(!audioCtx || muted) return;
    const t = audioCtx.currentTime;
    const o = audioCtx.createOscillator();
    o.type='sine'; o.frequency.setValueAtTime(72,t); o.frequency.exponentialRampToValueAtTime(38,t+0.18);
    const g = audioCtx.createGain();
    g.gain.setValueAtTime(0.0001,t);
    g.gain.exponentialRampToValueAtTime(0.9,t+0.02);
    g.gain.exponentialRampToValueAtTime(0.0001,t+0.22);
    o.connect(g); g.connect(master);
    o.start(t); o.stop(t+0.24);
  }

  function whoosh(){ noiseBurst(0.55, 'bandpass', 120, 900, 0.35); }

  function stinger(){
    noiseBurst(0.9, 'lowpass', 1400, 80, 0.9);
    if(audioCtx){
      const t = audioCtx.currentTime;
      const o = audioCtx.createOscillator();
      o.type='sawtooth'; o.frequency.setValueAtTime(160,t); o.frequency.exponentialRampToValueAtTime(30,t+0.8);
      const g = audioCtx.createGain();
      g.gain.setValueAtTime(0.7,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.9);
      o.connect(g); g.connect(master);
      o.start(t); o.stop(t+0.9);
    }
  }

  function fadeDrone(target, time){
    if(!droneGain||!audioCtx) return;
    droneGain.gain.cancelScheduledValues(audioCtx.currentTime);
    droneGain.gain.setValueAtTime(Math.max(droneGain.gain.value,0.0001), audioCtx.currentTime);
    droneGain.gain.exponentialRampToValueAtTime(Math.max(target,0.0001), audioCtx.currentTime+time);
  }

  muteBtn.addEventListener('click', (e)=>{
    e.stopPropagation();
    muted = !muted;
    muteBtn.textContent = muted ? '🔇' : '🔊';
    if(master) master.gain.value = muted?0:0.75;
  });

  reloadBtn.addEventListener('click', (e)=>{
    e.stopPropagation();
    location.reload();
  });
  // -------------------------------------------------------------------

  // ---------- Firebase ranking ----------
  const firebaseConfig = {
    apiKey: "AIzaSyAitmCVB6ILKx2CgxmC7CIKlf16OSch_N4",
    authDomain: "hirai1.firebaseapp.com",
    projectId: "hirai1",
    storageBucket: "hirai1.firebasestorage.app",
    messagingSenderId: "227398539379",
    appId: "1:227398539379:web:44ead14c65d055c5e9b206",
    measurementId: "G-K8CK47S5KB"
  };
  let db = null;
  try{
    firebase.initializeApp(firebaseConfig);
    db = firebase.firestore();
  }catch(e){ console.error('firebase init failed', e); }

  function getUsername(){
    let n='';
    try{ n = localStorage.getItem('hiraikunName')||''; }catch(e){}
    return n;
  }
  function setUsername(n){
    try{ localStorage.setItem('hiraikunName', n); }catch(e){}
  }
  function ensureUsername(){
    let n = getUsername();
    if(!n){
      n = '名無し' + Math.floor(Math.random()*9000+1000);
      setUsername(n);
    }
    return n;
  }
  ensureUsername();
  usernameInput.value = getUsername();

  saveNameBtn.addEventListener('click', ()=>{
    const v = usernameInput.value.trim().slice(0,10);
    if(!v) return;
    setUsername(v);
    rankStatus.textContent = 'ユーザーネームを保存しました';
    setTimeout(()=>{ if(rankStatus.textContent==='ユーザーネームを保存しました') rankStatus.textContent=''; }, 1500);
  });

  function formatTime(sec){
    return sec.toFixed(1);
  }

  function getUserId(){
    let id='';
    try{ id = localStorage.getItem('hiraikunUserId')||''; }catch(e){}
    if(!id){
      id = (crypto && crypto.randomUUID) ? crypto.randomUUID() : ('u'+Date.now()+Math.random().toString(16).slice(2));
      try{ localStorage.setItem('hiraikunUserId', id); }catch(e){}
    }
    return id;
  }
  const userId = getUserId();

  function submitScore(timeSec){
    if(!db || timeSec < 1) return;
    const name = ensureUsername();
    const roundedTime = Math.round(timeSec*10)/10;
    const docRef = db.collection('rankings').doc(userId);
    docRef.get().then(doc=>{
      if(doc.exists && Number(doc.data().time) >= roundedTime){
        return; // already have an equal or better all-time record, keep it
      }
      return docRef.set({
        name: name,
        time: roundedTime,
        ts: firebase.firestore.FieldValue.serverTimestamp()
      });
    }).catch(e=>console.error('submitScore failed', e));
  }

  function loadRanking(){
    rankStatus.textContent = '読み込み中...';
    rankList.innerHTML = '';
    if(!db){ rankStatus.textContent = 'ランキングに接続できません'; return; }
    document.getElementById('weekLabel').textContent = 'ランキング';
    db.collection('rankings')
      .limit(200)
      .get()
      .then(snap=>{
        if(snap.empty){
          rankStatus.textContent = 'まだ記録がありません';
          return;
        }
        rankStatus.textContent = '';
        const rows = [];
        snap.forEach(doc=>rows.push(Object.assign({id:doc.id}, doc.data())));
        rows.sort((a,b)=> (Number(b.time)||0) - (Number(a.time)||0));
        // de-dupe by display name: leftover legacy documents (pre weekKey removal)
        // can leave more than one row per real person; keep only their best (first
        // after the desc sort) so each person appears once. Also clean up the
        // losing duplicate documents in the background so only the best remains.
        const seenNames = new Set();
        const deduped = [];
        const staleDupeIds = [];
        rows.forEach(r=>{
          const key = r.name || '???';
          if(seenNames.has(key)){ staleDupeIds.push(r.id); return; }
          seenNames.add(key);
          deduped.push(r);
        });
        if(staleDupeIds.length){
          staleDupeIds.forEach(id=>{
            db.collection('rankings').doc(id).delete().catch(()=>{});
          });
        }
        const top = deduped.slice(0,30);
        const seasonKey = rkSeasonKey(new Date());
        const rpFetches = top.map(r=>db.collection('rank_progress').doc(seasonKey+'_'+r.id).get().catch(()=>null));
        Promise.all(rpFetches).then(rpDocs=>{
          top.forEach((d,idx)=>{
            const rpDoc = rpDocs[idx];
            const rp = (rpDoc && rpDoc.exists) ? (rpDoc.data().rp||0) : 0;
            const info = rkRankInfo(rp);
            const li = document.createElement('li');
            li.innerHTML = '<span class="rk">'+(idx+1)+'</span><span class="nm">'+escapeHtml(d.name||'???')+' <span style="color:#888;font-size:10px;">['+escapeHtml(info.name)+']</span></span><span class="tm">'+Number(d.time).toFixed(1)+'秒</span>';
            rankList.appendChild(li);
          });
        });
      })
      .catch(e=>{
        console.error(e);
        rankStatus.textContent = '読み込みに失敗しました: ' + (e && (e.code || e.message) || '不明なエラー');
      });
  }

  function loadRankPointsBoard(){
    rankStatus.textContent = '読み込み中...';
    rankList.innerHTML = '';
    if(!db){ rankStatus.textContent = 'ランキングに接続できません'; return; }
    document.getElementById('weekLabel').textContent = 'ランクポイント順(今シーズン)';
    const seasonKey = rkSeasonKey(new Date());
    const prefix = seasonKey+'_';
    db.collection('rank_progress')
      .where(firebase.firestore.FieldPath.documentId(), '>=', prefix)
      .where(firebase.firestore.FieldPath.documentId(), '<', prefix+'\uf8ff')
      .limit(200)
      .get()
      .then(snap=>{
        if(snap.empty){
          rankStatus.textContent = 'まだ記録がありません';
          return;
        }
        rankStatus.textContent = '';
        const rows = [];
        snap.forEach(doc=>rows.push(doc.data()));
        rows.sort((a,b)=> (Number(b.rp)||0) - (Number(a.rp)||0));
        rows.slice(0,30).forEach((d,idx)=>{
          const info = rkRankInfo(Number(d.rp)||0);
          const li = document.createElement('li');
          li.innerHTML = '<span class="rk">'+(idx+1)+'</span><span class="nm">'+escapeHtml(d.name||'???')+' <span style="color:#888;font-size:10px;">['+escapeHtml(info.name)+']</span></span><span class="tm">'+(Number(d.rp)||0)+' RP</span>';
          rankList.appendChild(li);
        });
      })
      .catch(e=>{
        console.error(e);
        rankStatus.textContent = '読み込みに失敗しました: ' + (e && (e.code || e.message) || '不明なエラー');
      });
  }

  let rkLeaderboardTab = 'time';
  function rkSetLeaderboardTab(tab){
    rkLeaderboardTab = tab;
    rankTabTime.className = tab==='time' ? 'btn small' : 'btn secondary small';
    rankTabRank.className = tab==='rank' ? 'btn small' : 'btn secondary small';
    if(tab==='time') loadRanking(); else loadRankPointsBoard();
  }
  rankTabTime.addEventListener('click', ()=>rkSetLeaderboardTab('time'));
  rankTabRank.addEventListener('click', ()=>rkSetLeaderboardTab('rank'));

  function escapeHtml(s){
    return String(s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  // ---------------- collection (ultra-rare giant variants) ----------------
  const COLLECTION_ITEMS = [
    { key:'golden', name:'ゴールデン飛来くん', odds:'1 / 10,000', img:'data:image/png;base64,', chance: 1/10000 },
    { key:'silver', name:'シルバー飛来くん', odds:'1 / 1,000', img:'data:image/png;base64,', chance: 1/1000 },
    { key:'yamata_silver', name:'ヤマたくん(シルバー)', odds:'1 / 1,000', img:'data:image/png;base64,', chance: 1/1000 },
    { key:'yamata_gold', name:'ヤマたくん(ゴールド)', odds:'1 / 10,000', img:'data:image/png;base64,', chance: 1/10000 },
    { key:'yamata_old_silver', name:'年老いヤマたくん(シルバー)', odds:'1 / 1,000', img:'data:image/png;base64,', chance: 1/1000 },
    { key:'yamata_old_gold', name:'年老いヤマたくん(ゴールド)', odds:'1 / 10,000', img:'data:image/png;base64,', chance: 1/10000 },
    { key:'yamata', name:'ヤマたくん', odds:'1 / 1,000', img:'data:image/png;base64,', chance: 1/1000 },
    { key:'yamata_old', name:'年老いヤマたくん', odds:'1 / 1,000', img:'data:image/png;base64,', chance: 1/1000 }
  ];

  function loadCollection(){
    try{
      return JSON.parse(localStorage.getItem('hiraikunCollection')||'{}');
    }catch(e){ return {}; }
  }
  function saveCollection(coll){
    try{ localStorage.setItem('hiraikunCollection', JSON.stringify(coll)); }catch(e){}
  }
  function unlockCollectionItem(key){
    const coll = loadCollection();
    if(coll[key]) return false;
    coll[key] = true;
    saveCollection(coll);
    return true;
  }
  function renderCollection(){
    const coll = loadCollection();
    collectionGrid.innerHTML = COLLECTION_ITEMS.map(item=>{
      const unlocked = !!coll[item.key];
      if(unlocked){
        return '<div class="collCard"><img src="'+item.img+'" alt=""><div class="collName">'+escapeHtml(item.name)+'</div><div class="collOdds">'+item.odds+'</div></div>';
      }
      return '<div class="collCard locked"><div class="collSilhouette">？</div><div class="collName">？？？</div><div class="collOdds">'+item.odds+'</div></div>';
    }).join('');
  }
  collectionBtn.addEventListener('click', ()=>{
    renderCollection();
    showScreen(collectionScreen);
  });
  collectionBackBtn.addEventListener('click', ()=>{ showScreen(startScreen); });

  let discoveryToastTimer = null;
  function showDiscoveryToast(name){
    discoveryToast.textContent = '✨ ' + name + ' を発見！コレクションに追加されました';
    discoveryToast.classList.add('show');
    if(discoveryToastTimer) clearTimeout(discoveryToastTimer);
    discoveryToastTimer = setTimeout(()=>{ discoveryToast.classList.remove('show'); }, 4200);
  }

  // rolls for a special giant variant; returns the matching COLLECTION_ITEMS entry or null.
  // checked independently and in rarity order so the rarest variant wins if multiple hit at once.
  function rollSpecialGiant(){
    // each item gets its own independent roll at exactly its stated odds;
    // with a single shared roll, items that share the same rarity would
    // only ever let the first one in the list actually appear.
    let best = null;
    for(const item of COLLECTION_ITEMS){
      if(Math.random() < item.chance){
        if(!best || item.chance < best.chance) best = item;
      }
    }
    return best;
  }
  // ---------------------------------------------------------------------

  function openRanking(){
    rankScreen.style.display = 'flex';
    rkSetLeaderboardTab(rkLeaderboardTab);
  }
  function closeRanking(){
    rankScreen.style.display = 'none';
  }

  rankBtn.addEventListener('click', openRanking);
  overRankBtn.addEventListener('click', openRanking);
  rankBackBtn.addEventListener('click', ()=>{
    closeRanking();
    startScreen.style.display = 'flex';
    overScreen.style.display = 'none';
  });
  overHomeBtn.addEventListener('click', ()=>{
    overScreen.style.display = 'none';
    startScreen.style.display = 'flex';
  });
  // ---------------------------------------

  let laneIdx = 1;
  let running=false, gameOver=false;
  let mode = 'solo'; // 'solo' | 'vs'
  let rng = Math.random;
  let score=0, best=0;
  try{ best = parseFloat(localStorage.getItem('hiraikunBestTime')||'0')||0; }catch(e){best=0;}
  bestDistEl.textContent = formatTime(best);

  let objs = [];
  let spawnTimer=0, spawnInterval=1500, fallDuration=1750, elapsed=0;
  let lastTime=0;

  let lastSentLane = 1;
  function setPlayerLane(idx){
    laneIdx = Math.max(0, Math.min(LANES.length-1, idx));
    player.style.left = LANES[laneIdx]+'%';
    if(mode==='vs' && roomRef && laneIdx!==lastSentLane){
      lastSentLane = laneIdx;
      const field = myRole==='p1' ? 'p1Lane' : 'p2Lane';
      roomRef.update({[field]: laneIdx}).catch(()=>{});
    }
  }
  setPlayerLane(1);

  function moveLeft(){ if(!running||gameOver) return; setPlayerLane(laneIdx-1); }
  function moveRight(){ if(!running||gameOver) return; setPlayerLane(laneIdx+1); }

  window.addEventListener('pagehide', ()=>{
    if(mode==='vs' && running && !myVsDone && roomRef){
      const field = myRole==='p1' ? {p1Time: elapsed, p1Done: true} : {p2Time: elapsed, p2Done: true};
      roomRef.update(field).catch(()=>{});
    }
  });

  window.addEventListener('keydown', (e)=>{
    if(e.code==='ArrowLeft'){ e.preventDefault(); moveLeft(); }
    if(e.code==='ArrowRight'){ e.preventDefault(); moveRight(); }
  });
  document.getElementById('tapLeft').addEventListener('pointerdown', moveLeft);
  document.getElementById('tapRight').addEventListener('pointerdown', moveRight);

  let touchStartX=null;
  stage.addEventListener('touchstart', (e)=>{ touchStartX = e.touches[0].clientX; }, {passive:true});
  stage.addEventListener('touchend', (e)=>{
    if(touchStartX===null) return;
    const dx = e.changedTouches[0].clientX - touchStartX;
    if(Math.abs(dx) > 28){ dx>0 ? moveRight() : moveLeft(); }
    touchStartX=null;
  }, {passive:true});

  function spawnGiant(){
    const lane = Math.floor(rng()*LANES.length);
    const el = document.createElement('div');
    el.className='giant-obj';
    el.style.left = LANES[lane]+'%';

    let special = null;
    if(mode==='solo'){
      special = rollSpecialGiant();
    }
    el.innerHTML = '<img src="' + (special ? special.img : 'data:image/png;base64,') + '">';
    if(special){
      el.classList.add('giant-special');
      const label = document.createElement('div');
      label.className = 'giant-special-label';
      label.textContent = special.name;
      el.appendChild(label);
      if(unlockCollectionItem(special.key)){
        showDiscoveryToast(special.name);
      }
    }

    lanesEl.appendChild(el);
    objs.push({ el, lane, t0: performance.now(), dur: fallDuration, resolved:false });
    whoosh();
  }

  function updateObjs(now){
    for(let i=objs.length-1;i>=0;i--){
      const o = objs[i];
      const p = (now - o.t0) / o.dur;
      if(p >= 1){
        if(o.lane === laneIdx){
          triggerCatch();
          return;
        } else {
          score++;
          o.el.remove();
          objs.splice(i,1);
          continue;
        }
      }
      const scale = 0.15 + Math.pow(p,1.3)*1.55;
      const top = -15 + p*103;
      const opacity = Math.min(1, 0.3 + p*0.9);
      o.el.style.top = top+'%';
      o.el.style.transform = 'translate(-50%,0) scale('+scale.toFixed(3)+')';
      o.el.style.opacity = opacity.toFixed(2);
      o.el.style.zIndex = 10 + Math.floor(p*10);
    }
  }

  function loop(now){
    if(!lastTime) lastTime = now;
    const dt = Math.min(0.05, (now-lastTime)/1000);
    lastTime = now;

    if(running && !gameOver){
      elapsed += dt;
      spawnTimer += dt*1000;
      spawnInterval = Math.max(380, 1500 - elapsed*34);
      fallDuration = Math.max(680, 1750 - elapsed*30);
      if(spawnTimer >= spawnInterval){
        spawnTimer = 0;
        spawnGiant();
        if(elapsed > 12 && rng() < 0.35){
          setTimeout(()=>{ if(running && !gameOver) spawnGiant(); }, 180);
        }
      }
      updateObjs(now);
      scoreVal.textContent = formatTime(elapsed);

      heartInterval = Math.max(260, 900 - elapsed*20);
      if(now >= nextHeartAt){
        heartThump();
        nextHeartAt = now + heartInterval;
      }
      if(droneGain && audioCtx){
        const target = 0.05 + Math.min(1, elapsed/40) * 0.16;
        droneGain.gain.setTargetAtTime(target, audioCtx.currentTime, 0.6);
      }
    }
    requestAnimationFrame(loop);
  }

  let clockMin=42, clockHour=17;
  setInterval(()=>{
    if(!running) return;
    clockMin++;
    if(clockMin>=60){clockMin=0;clockHour=(clockHour+1)%24;}
    tsEl.textContent = '2025.10.18\u00A0\u00A0'+String(clockHour).padStart(2,'0')+':'+String(clockMin).padStart(2,'0');
  }, 3000);

  function triggerCatch(){
    gameOver = true; running = false;
    stinger();
    fadeDrone(0.0001, 0.5);
    redflash.style.transition='opacity 0.06s linear';
    redflash.style.opacity='0.85';
    jumpscare.style.transition='none';
    jumpscare.style.opacity='1';
    let shakes=0;
    const shakeInt = setInterval(()=>{
      stage.style.transform='translate('+(Math.random()*14-7)+'px,'+(Math.random()*14-7)+'px)';
      shakes++;
      if(shakes>10){ clearInterval(shakeInt); stage.style.transform=''; }
    },40);
    setTimeout(()=>{ redflash.style.transition='opacity 0.4s linear'; redflash.style.opacity='0'; },160);

    if(mode==='vs'){
      handleVsFinish();
    } else {
      submitScore(elapsed);
      setTimeout(()=>{
        finalDist.textContent = formatTime(elapsed);
        if(elapsed>best){ best=elapsed; try{localStorage.setItem('hiraikunBestTime',String(best));}catch(e){} }
        bestDistEl.textContent = formatTime(best);
        overScreen.style.display='flex';
      }, 650);
    }
    setTimeout(()=>{
      jumpscare.style.transition = 'opacity 0.6s ease-out';
      jumpscare.style.opacity = '0';
    }, 2200);
  }

  function startGame(){
    ensureAudio();
    if(audioCtx.state === 'suspended') audioCtx.resume();
    mode = 'solo';
    rng = Math.random;
    playerOpp.style.display = 'none';
    vsStatus.style.display = 'none';
    player.querySelector('.mark').style.background = '#ffd23b';
    player.querySelector('.mark').style.boxShadow = '0 0 8px #ffd23b';
    startScreen.style.display='none';
    overScreen.style.display='none';
    closeRanking();
    jumpscare.style.opacity='0';
    objs.forEach(o=>o.el.remove());
    objs = [];
    score=0; elapsed=0; spawnTimer=0; gameOver=false;
    spawnInterval=1500; fallDuration=1750;
    heartInterval=900; nextHeartAt=performance.now()+600;
    scoreVal.textContent='0.0';
    setPlayerLane(1);
    running=true;
    fadeDrone(0.05, 1.2);
  }

  startBtn.addEventListener('click', startGame);
  retryBtn.addEventListener('click', startGame);

  // ================= VS MODE =================
  function mulberry32(seed){
    let a = seed >>> 0;
    return function(){
      a |= 0; a = (a + 0x6D2B79F5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function genRoomCode(){
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let s='';
    for(let i=0;i<6;i++) s += chars[Math.floor(Math.random()*chars.length)];
    return s;
  }

  let myRole = null;      // 'p1' | 'p2'
  let roomId = null;
  let roomRef = null;
  let roomUnsub = null;
  let oppLaneIdx = 1;
  let lastRoomData = null;
  let oppDone = false, oppTime = 0;
  let oppName = '';
  let myVsDone = false;
  let resultShown = false;
  let countdownFired = false;
  let oppDoneGraceScheduled = false;
  let vsEndReason = null;
  let presenceTimer = null;

  function startPresenceHeartbeat(){
    stopPresenceHeartbeat();
    const sendBeat = ()=>{
      if(!roomRef || myVsDone || mode!=='vs' || !running){ stopPresenceHeartbeat(); return; }
      const field = myRole==='p1' ? 'p1Seen' : 'p2Seen';
      roomRef.update({[field]: firebase.firestore.FieldValue.serverTimestamp()}).catch(()=>{});
    };
    sendBeat(); // send immediately so the opponent has a baseline right away
    presenceTimer = setInterval(sendBeat, 4000);
  }
  function stopPresenceHeartbeat(){
    if(presenceTimer){ clearInterval(presenceTimer); presenceTimer=null; }
  }

  function resetVsState(){
    myRole=null; roomId=null; oppLaneIdx=1; oppDone=false; oppTime=0;
    myVsDone=false; resultShown=false; countdownFired=false; oppDoneGraceScheduled=false;
    vsEndReason=null; oppName='';
    if(roomUnsub){ roomUnsub(); roomUnsub=null; }
    if(roomPollTimer){ clearInterval(roomPollTimer); roomPollTimer=null; }
    if(randomRetryTimer){ clearInterval(randomRetryTimer); randomRetryTimer=null; }
    stopHostHeartbeat();
    stopPresenceHeartbeat();
    roomRef = null;
  }

  function showScreen(el){
    [startScreen, overScreen, rankScreen, vsMenuScreen, vsWaitScreen, vsResultScreen,
     rkMenuScreen, rkWaitScreen, rkGameScreen, rkResultScreen, collectionScreen].forEach(s=>{ if(s) s.style.display='none'; });
    if(el) el.style.display = (el===rkGameScreen) ? 'block' : 'flex';
  }

  vsBtn.addEventListener('click', ()=>{
    vsMenuStatus.textContent='';
    roomIdInput.value='';
    showScreen(vsMenuScreen);
  });
  vsMenuBackBtn.addEventListener('click', ()=>{ showScreen(startScreen); });

  createRoomBtn.addEventListener('click', ()=>{
    if(!db){ vsMenuStatus.textContent='通信に接続できません'; return; }
    resetVsState();
    myRole = 'p1';
    roomId = genRoomCode();
    roomRef = db.collection('rooms').doc(roomId);
    const seed = Math.floor(Math.random()*1e9);
    roomRef.set({
      host: userId, hostName: ensureUsername(),
      guest: null, guestName: null,
      seed: seed, status:'waiting', isPublic:false,
      p1Lane:1, p2Lane:1,
      p1Done:false, p2Done:false, p1Time:0, p2Time:0, p1Seen:null, p2Seen:null,
      createdAt: firebase.firestore.FieldValue.serverTimestamp()
    }).then(()=>{
      vsWaitSub.textContent = 'このルームIDを相手に伝えてください';
      roomCodeDisplay.textContent = roomId;
      showScreen(vsWaitScreen);
      watchRoom();
    }).catch(e=>{ console.error(e); vsMenuStatus.textContent='ルーム作成に失敗しました'; });
  });

  // ---------- random matchmaking ----------
  let randomRetryTimer = null;
  let heartbeatTimer = null;
  const PRESENCE_TIMEOUT_MS = 15000;

  function extractFreshCandidateIds(snap, excludeId){
    const now = Date.now();
    const ids = [];
    snap.forEach(doc=>{
      if(doc.id === excludeId) return;
      const data = doc.data();
      let refMs = 0;
      if(data.lastSeen && typeof data.lastSeen.toMillis === 'function') refMs = data.lastSeen.toMillis();
      else if(data.createdAt && typeof data.createdAt.toMillis === 'function') refMs = data.createdAt.toMillis();
      // no timestamp resolved yet (very just-created) counts as fresh;
      // otherwise the host must have checked in within PRESENCE_TIMEOUT_MS
      const isFresh = refMs === 0 || (now - refMs) < PRESENCE_TIMEOUT_MS;
      if(isFresh) ids.push(doc.id);
    });
    return ids;
  }

  function startHostHeartbeat(){
    stopHostHeartbeat();
    heartbeatTimer = setInterval(()=>{
      if(!roomRef || countdownFired || myRole!=='p1'){ stopHostHeartbeat(); return; }
      roomRef.update({lastSeen: firebase.firestore.FieldValue.serverTimestamp()}).catch(()=>{});
    }, 5000);
  }
  function stopHostHeartbeat(){
    if(heartbeatTimer){ clearInterval(heartbeatTimer); heartbeatTimer=null; }
  }

  randomMatchBtn.addEventListener('click', ()=>{
    if(!db){ vsMenuStatus.textContent='通信に接続できません'; return; }
    resetVsState();
    vsMenuStatus.textContent = 'ランダムな相手を探しています...';
    findOrCreateRandomMatch();
  });

  function findOrCreateRandomMatch(excludeId){
    db.collection('rooms')
      .where('isPublic','==',true)
      .where('guest','==',null)
      .limit(8)
      .get()
      .then(snap=>{
        const candidates = extractFreshCandidateIds(snap, excludeId);
        if(candidates.length > 0){
          tryClaimRoom(candidates, 0);
        } else {
          createRandomRoom();
        }
      })
      .catch(e=>{ console.error(e); vsMenuStatus.textContent='マッチングに失敗しました'; });
  }

  function tryClaimRoom(candidates, idx){
    if(idx >= candidates.length){ createRandomRoom(); return; }
    const ref = db.collection('rooms').doc(candidates[idx]);
    db.runTransaction(t=>{
      return t.get(ref).then(doc=>{
        if(!doc.exists || doc.data().guest){ throw new Error('taken'); }
        t.update(ref, { guest:userId, guestName: ensureUsername(), status:'ready' });
      });
    }).then(()=>{
      myRole = 'p2';
      roomId = candidates[idx];
      roomRef = ref;
      vsWaitSub.textContent = 'マッチしました！開始を待っています';
      roomCodeDisplay.textContent = roomId;
      showScreen(vsWaitScreen);
      watchRoom();
    }).catch(()=>{
      tryClaimRoom(candidates, idx+1);
    });
  }

  function createRandomRoom(){
    myRole = 'p1';
    roomId = genRoomCode();
    roomRef = db.collection('rooms').doc(roomId);
    const seed = Math.floor(Math.random()*1e9);
    roomRef.set({
      host: userId, hostName: ensureUsername(),
      guest: null, guestName: null,
      seed: seed, status:'waiting', isPublic:true,
      p1Lane:1, p2Lane:1,
      p1Done:false, p2Done:false, p1Time:0, p2Time:0, p1Seen:null, p2Seen:null,
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      lastSeen: firebase.firestore.FieldValue.serverTimestamp()
    }).then(()=>{
      vsWaitSub.textContent = 'ランダムな対戦相手を探しています(このIDを人に伝えても参加できます)';
      roomCodeDisplay.textContent = roomId;
      showScreen(vsWaitScreen);
      watchRoom();
      startHostHeartbeat();
      let tries = 0;
      randomRetryTimer = setInterval(()=>{
        tries++;
        if(tries > 5 || countdownFired){ clearInterval(randomRetryTimer); randomRetryTimer=null; return; }
        db.collection('rooms').where('isPublic','==',true).where('guest','==',null).limit(8).get().then(snap=>{
          const others = extractFreshCandidateIds(snap, roomId);
          if(others.length > 0 && roomRef && !countdownFired){
            clearInterval(randomRetryTimer); randomRetryTimer=null;
            stopHostHeartbeat();
            const oldRef = roomRef;
            if(roomUnsub){ roomUnsub(); roomUnsub=null; }
            oldRef.delete().catch(()=>{});
            tryClaimRoom(others, 0);
          }
        }).catch(()=>{});
      }, 3000);
    }).catch(e=>{ console.error(e); vsMenuStatus.textContent='マッチング待機に失敗しました'; });
  }
  // -----------------------------------------

  joinRoomBtn.addEventListener('click', ()=>{
    if(!db){ vsMenuStatus.textContent='通信に接続できません'; return; }
    const code = roomIdInput.value.trim().toUpperCase();
    if(code.length < 4){ vsMenuStatus.textContent='ルームIDを入力してください'; return; }
    resetVsState();
    const ref = db.collection('rooms').doc(code);
    ref.get().then(doc=>{
      if(!doc.exists){ vsMenuStatus.textContent='ルームが見つかりません'; return; }
      const d = doc.data();
      if(d.guest){ vsMenuStatus.textContent='このルームは満員です'; return; }
      myRole = 'p2';
      roomId = code;
      roomRef = ref;
      return roomRef.update({ guest:userId, guestName: ensureUsername(), status:'ready' }).then(()=>{
        vsWaitSub.textContent = 'マッチしました！開始を待っています';
        roomCodeDisplay.textContent = roomId;
        showScreen(vsWaitScreen);
        watchRoom();
      });
    }).catch(e=>{ console.error(e); vsMenuStatus.textContent='参加に失敗しました'; });
  });

  cancelRoomBtn.addEventListener('click', ()=>{
    if(randomRetryTimer){ clearInterval(randomRetryTimer); randomRetryTimer=null; }
    if(roomRef){
      if(myRole==='p1'){ roomRef.delete().catch(()=>{}); }
      else if(myRole==='p2'){ roomRef.update({guest:null, guestName:null, status:'waiting'}).catch(()=>{}); }
    }
    resetVsState();
    showScreen(vsMenuScreen);
  });

  function handleRoomUpdate(d){
    lastRoomData = d;
    const oppNameFromDoc = myRole==='p1' ? d.guestName : d.hostName;
    if(oppNameFromDoc && oppNameFromDoc !== oppName){
      oppName = oppNameFromDoc;
      updateVsStatusLine();
    }
    // opponent lane sync
    const oppField = myRole==='p1' ? 'p2Lane' : 'p1Lane';
    if(typeof d[oppField] === 'number'){
      oppLaneIdx = d[oppField];
      if(mode==='vs' && running){
        playerOpp.style.left = LANES[oppLaneIdx] + '%';
      }
    }

    // host: start countdown once guest joins
    if(myRole==='p1' && d.guest && !countdownFired){
      countdownFired = true;
      startVsCountdown(d.seed);
    }
    // guest: start countdown once it sees its own join reflected (or immediately after join call resolves)
    if(myRole==='p2' && d.guest && !countdownFired){
      countdownFired = true;
      startVsCountdown(d.seed);
    }

    // opponent finish tracking
    const oppDoneField = myRole==='p1' ? 'p2Done' : 'p1Done';
    const oppTimeField = myRole==='p1' ? 'p2Time' : 'p1Time';
    if(d[oppDoneField]){
      oppDone = true;
      oppTime = d[oppTimeField] || 0;
      if(myVsDone && !resultShown){
        showVsResult(d);
      } else if(!myVsDone && mode==='vs' && running && !oppDoneGraceScheduled){
        // opponent finished first - give me a short grace window in case
        // I'm also about to be caught at essentially the same instant
        // (near-simultaneous death should be a tie, not a forced loss/win)
        oppDoneGraceScheduled = true;
        updateVsStatusLine();
        setTimeout(()=>{
          if(!myVsDone && mode==='vs' && running){
            endVsMatchAsWinner();
          }
        }, 500);
      } else {
        updateVsStatusLine();
      }
    }

    // opponent presence check - if they've gone silent mid-match, treat as a
    // disconnect/leave and end the match rather than waiting forever
    if(mode==='vs' && running && !myVsDone && countdownFired){
      const oppSeenField = myRole==='p1' ? 'p2Seen' : 'p1Seen';
      const seenVal = d[oppSeenField];
      let stale = false;
      if(seenVal && typeof seenVal.toMillis === 'function'){
        const ms = seenVal.toMillis();
        if(ms > 0 && (Date.now() - ms) > 10000) stale = true;
      } else if(elapsed > 12){
        // never got a single heartbeat from the opponent - if it's been
        // this long they almost certainly disconnected before sending one
        stale = true;
      }
      if(stale){
        endVsMatchAsWinner('left');
      }
    }
  }

  let roomPollTimer = null;

  function watchRoom(){
    roomUnsub = roomRef.onSnapshot(snap=>{
      if(!snap.exists){
        if(!resultShown){
          vsMenuStatus.textContent='ルームが閉じられました';
          resetVsState();
          showScreen(vsMenuScreen);
        }
        return;
      }
      handleRoomUpdate(snap.data());
    }, err=>{
      console.error('room watch error', err);
      if(vsWaitScreen.style.display==='flex'){
        vsWaitSub.textContent = '通信エラーが発生しました。再取得を試みています...';
      }
    });

    // polling fallback in case the realtime listener stalls
    // (network blips, backgrounded tabs, etc.) - keep polling through
    // the whole match so opponent-presence timeouts still get checked
    if(roomPollTimer){ clearInterval(roomPollTimer); }
    roomPollTimer = setInterval(()=>{
      if(!roomRef || resultShown){ clearInterval(roomPollTimer); roomPollTimer=null; return; }
      roomRef.get({source:'server'}).then(doc=>{
        if(doc.exists) handleRoomUpdate(doc.data());
      }).catch(e=>console.error('room poll error', e));
    }, 2500);
  }

  function endVsMatchAsWinner(reason){
    running = false; gameOver = true;
    myVsDone = true;
    vsEndReason = reason || null;
    fadeDrone(0.0001, 0.5);
    stopPresenceHeartbeat();
    const field = myRole==='p1' ? {p1Time: elapsed, p1Done:true} : {p2Time: elapsed, p2Done:true};
    if(roomRef) roomRef.update(field).catch(e=>console.error(e));
  }

  function updateVsStatusLine(){
    if(mode!=='vs') return;
    const label = oppName || '相手';
    if(oppDone){
      vsStatus.textContent = label + ': 脱落 (' + formatTime(oppTime) + '秒)';
    } else {
      vsStatus.textContent = label + ': 生存中';
    }
  }

  function startVsCountdown(seed){
    showScreen(null);
    vsWaitScreen.style.display='none';
    vsCountdownScreen.style.display='flex';
    let n = 3;
    countdownNum.textContent = n;
    const iv = setInterval(()=>{
      n--;
      if(n>0){
        countdownNum.textContent = n;
      } else if(n===0){
        countdownNum.textContent = 'START';
      } else {
        clearInterval(iv);
        vsCountdownScreen.style.display='none';
        beginVsMatch(seed);
      }
    }, 700);
  }

  function beginVsMatch(seed){
    ensureAudio();
    if(audioCtx.state === 'suspended') audioCtx.resume();
    mode = 'vs';
    rng = mulberry32(seed);
    myVsDone = false; oppDone = false; oppTime = 0; resultShown = false;
    oppDoneGraceScheduled = false;
    jumpscare.style.opacity='0';
    objs.forEach(o=>o.el.remove());
    objs = [];
    score=0; elapsed=0; spawnTimer=0; gameOver=false;
    spawnInterval=1500; fallDuration=1750;
    heartInterval=900; nextHeartAt=performance.now()+600;
    scoreVal.textContent='0.0';

    const myColor = myRole==='p1' ? '#ff3b3b' : '#3b8aff';
    const oppColor = myRole==='p1' ? '#3b8aff' : '#ff3b3b';
    player.querySelector('.mark').style.background = myColor;
    player.querySelector('.mark').style.boxShadow = '0 0 8px '+myColor;
    playerOpp.querySelector('.mark').style.background = oppColor;
    playerOpp.querySelector('.mark').style.boxShadow = '0 0 8px '+oppColor;
    playerOpp.style.display = 'block';
    playerOpp.style.left = LANES[1]+'%';
    vsStatus.style.display = 'block';
    updateVsStatusLine();

    lastSentLane = -1;
    setPlayerLane(1);
    running = true;
    fadeDrone(0.05, 1.2);
    startPresenceHeartbeat();
  }

  function handleVsFinish(){
    myVsDone = true;
    stopPresenceHeartbeat();
    const field = myRole==='p1' ? {p1Time: elapsed, p1Done: true} : {p2Time: elapsed, p2Done: true};
    if(roomRef) roomRef.update(field).catch(e=>console.error(e));
    setTimeout(()=>{
      if(oppDone){
        roomRef.get().then(doc=>{ if(doc.exists) showVsResult(doc.data()); });
      } else {
        vsResultTitle.textContent = '結果待ち';
        vsResultBody.innerHTML = 'あなたの生存タイム: ' + formatTime(elapsed) + '秒<br>対戦相手の結果を待っています...';
        vsResultHomeBtn.textContent = 'ホームへ戻る(対戦中止)';
        vsResultHomeBtn.style.display = 'inline-block';
        showScreen(vsResultScreen);
      }
    }, 650);
  }

  function showVsResult(d){
    if(resultShown) return;
    resultShown = true;
    const myTime = myRole==='p1' ? d.p1Time : d.p2Time;
    const otherTime = myRole==='p1' ? d.p2Time : d.p1Time;
    const myName = myRole==='p1' ? (d.hostName||'あなた') : (d.guestName||'あなた');
    const otherName = myRole==='p1' ? (d.guestName||'相手') : (d.hostName||'相手');
    let resultText;
    const diff = myTime - otherTime;
    if(Math.abs(diff) < 0.3) resultText = '引き分け';
    else if(diff > 0) resultText = '勝ち！';
    else resultText = '負け...';
    if(vsEndReason==='left' && diff > 0) resultText = '勝ち！(相手が退出)';
    vsResultTitle.textContent = resultText;
    vsResultBody.innerHTML =
      escapeHtml(myName) + ': ' + formatTime(myTime) + '秒<br>' +
      escapeHtml(otherName) + ': ' + formatTime(otherTime) + '秒';
    vsResultHomeBtn.textContent = 'ホームへ';
    vsResultHomeBtn.style.display = 'inline-block';
    showScreen(vsResultScreen);

    if(myRole==='p1' && roomRef){
      roomRef.delete().catch(e=>console.error('room cleanup failed', e));
    }
    resetVsState();
  }

  vsResultHomeBtn.addEventListener('click', ()=>{
    if(!resultShown && roomRef && myRole==='p1'){
      roomRef.delete().catch(()=>{});
    }
    running=false; gameOver=true;
    mode='solo'; rng=Math.random;
    playerOpp.style.display='none';
    vsStatus.style.display='none';
    resetVsState();
    showScreen(startScreen);
  });

  let waitDotN=0;
  setInterval(()=>{
    if(vsWaitScreen.style.display==='flex'){
      waitDotN=(waitDotN+1)%4;
      vsWaitDots.textContent = '.'.repeat(waitDotN+1);
    }
  }, 500);
  // =============================================


  requestAnimationFrame(loop);

  // ---------- PWA install ----------
  if('serviceWorker' in navigator){
    window.addEventListener('load', ()=>{
      navigator.serviceWorker.register('sw.js').catch(e=>console.error('sw register failed', e));
    });
  }

  let deferredPrompt = null;
  window.addEventListener('beforeinstallprompt', (e)=>{
    e.preventDefault();
    deferredPrompt = e;
    installBtn.style.display = 'inline-block';
  });
  installBtn.addEventListener('click', async ()=>{
    if(!deferredPrompt) return;
    deferredPrompt.prompt();
    await deferredPrompt.userChoice;
    deferredPrompt = null;
    installBtn.style.display = 'none';
  });
  window.addEventListener('appinstalled', ()=>{
    installBtn.style.display = 'none';
  });

  const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
  const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
  if(isIOS && !isStandalone){
    iosHint.style.display = 'block';
  }
  // ---------------------------------------

  // ================= RANKED MATCH (lane duel) =================
  const rkMenuScreen = document.getElementById('rkMenuScreen');
  const rkOpenBtn = document.getElementById('rkOpenBtn');
  const rkRandomBtn = document.getElementById('rkRandomBtn');
  const rkMenuStatus = document.getElementById('rkMenuStatus');
  const rkMenuBackBtn = document.getElementById('rkMenuBackBtn');
  const rkWaitScreen = document.getElementById('rkWaitScreen');
  const rkWaitDots = document.getElementById('rkWaitDots');
  const rkCancelBtn = document.getElementById('rkCancelBtn');
  const rkCountdownScreen = document.getElementById('rkCountdownScreen');
  const rkCountdownNum = document.getElementById('rkCountdownNum');
  const rkGameScreen = document.getElementById('rkGameScreen');
  const rkOppZone = document.getElementById('rkOppZone');
  const rkMyZone = document.getElementById('rkMyZone');
  const rkOppDot = document.getElementById('rkOppDot');
  const rkMyDot = document.getElementById('rkMyDot');
  const rkProjLayer = document.getElementById('rkProjLayer');
  const rkLaneGuides = document.getElementById('rkLaneGuides');
  {
    const lA = document.createElement('div');
    lA.className='laneLine'; lA.style.left = ((LANES[0]+LANES[1])/2)+'%';
    rkLaneGuides.appendChild(lA);
    const lB = document.createElement('div');
    lB.className='laneLine'; lB.style.left = ((LANES[1]+LANES[2])/2)+'%';
    rkLaneGuides.appendChild(lB);
  }
  const rkMyHeartsEl = document.getElementById('rkMyHearts');
  const rkOppHeartsEl = document.getElementById('rkOppHearts');
  const rkOppNameLabel = document.getElementById('rkOppNameLabel');
  const rkResultScreen = document.getElementById('rkResultScreen');
  const rkResultTitle = document.getElementById('rkResultTitle');
  const rkResultIconImg = document.getElementById('rkResultIconImg');
  const rkResultRankName = document.getElementById('rkResultRankName');
  const rkResultRPChange = document.getElementById('rkResultRPChange');
  const rkResultHomeBtn = document.getElementById('rkResultHomeBtn');
  const rkRankIconImg = document.getElementById('rkRankIconImg');
  const rkRankNameEl = document.getElementById('rkRankName');
  const rkRankRPEl = document.getElementById('rkRankRP');

  const RK_FIRE_COOLDOWN = 550;
  const RK_TRAVEL_MS = 550;
  const RK_WIN_RP = 25, RK_LOSE_RP = -15;
  const RK_BOT_NAMES = ['謎のbot','影の刺客','霧の中の誰か','木陰のbot','足音だけの相手','名もなき追跡者'];

  // ---- rank tier table (matches the reference image: Bronze-Diamond have IV..I, then 4 single top tiers) ----
  const RK_TIERS = (function(){
    const base = ['ブロンズ','シルバー','ゴールド','プラチナ','ダイヤモンド'];
    const subs = ['IV','III','II','I'];
    const list = [];
    base.forEach(n=>{ subs.forEach(s=>{ list.push(n+' '+s); }); });
    ['マスター','チャンピオン','アンリアル','オーバーロード'].forEach(n=>list.push(n));
    return list;
  })();
  function rkThresholdForIndex(i){
    if(i<=0) return 0;
    if(i<20) return i*100;
    return [2000,2400,2800,3200][i-20];
  }
  function rkRankIndexForRP(rp){
    let idx=0;
    for(let i=0;i<RK_TIERS.length;i++){
      if(rp >= rkThresholdForIndex(i)) idx=i; else break;
    }
    return idx;
  }
  function rkRankInfo(rp){
    const idx = rkRankIndexForRP(rp);
    return { idx, name: RK_TIERS[idx], rp };
  }
  function rkSpriteIndexForTierIdx(idx){
    return idx<20 ? Math.floor(idx/4) : (idx-15);
  }
  function rkSetIconEl(imgEl, tierIdx, sizePx){
    const spriteIdx = rkSpriteIndexForTierIdx(tierIdx);
    const scale = sizePx/72;
    imgEl.style.height = sizePx+'px';
    imgEl.style.width = (72*9*scale)+'px';
    imgEl.style.left = (-spriteIdx*72*scale)+'px';
  }

  function rkSeasonKey(d){
    return 'M'+d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
  }

  let rkMyRP = 0;
  function rkLoadMyRP(cb){
    if(!db){ cb&&cb(); return; }
    const key = rkSeasonKey(new Date())+'_'+userId;
    db.collection('rank_progress').doc(key).get().then(doc=>{
      rkMyRP = doc.exists ? (doc.data().rp||0) : 0;
      cb&&cb();
    }).catch(()=>{ cb&&cb(); });
  }
  function rkSaveMyRP(newRP){
    rkMyRP = Math.max(0,newRP);
    if(!db) return;
    const key = rkSeasonKey(new Date())+'_'+userId;
    db.collection('rank_progress').doc(key).set({
      name: ensureUsername(), rp: rkMyRP, updatedAt: firebase.firestore.FieldValue.serverTimestamp()
    }).catch(()=>{});
  }
  function rkUpdateMenuBadge(){
    const info = rkRankInfo(rkMyRP);
    rkRankNameEl.textContent = info.name;
    rkRankRPEl.textContent = 'RP '+info.rp;
    rkSetIconEl(rkRankIconImg, info.idx, 44);
  }

  // ---- state ----
  let rkRoomRef=null, rkRoomUnsub=null, rkRoomId=null, rkMyRole=null, rkOppUid=null, rkOppName='';
  let rkCountdownFired=false, rkRunning=false, rkResultShown=false;
  let rkMyLane=1, rkOppLane=1;
  let rkMyHits=0, rkOppHits=0;
  let rkProjectiles=[];
  let rkProcessedLaunchIds=new Set();
  let rkLastFireAt=0;
  let rkPresenceTimer=null, rkHeartbeatTimer=null, rkRetryTimer=null;
  let rkAnimHandle=null;
  let rkWaitDotN=0;
  let rkVsBot=false, rkBotFallbackTimer=null, rkBotActionTimer=null;
  const RK_BOT_FALLBACK_MS = 8000;

  function rkLeave(){
    rkRunning=false;
    if(rkAnimHandle){ cancelAnimationFrame(rkAnimHandle); rkAnimHandle=null; }
    if(rkRoomUnsub){ rkRoomUnsub(); rkRoomUnsub=null; }
    if(rkPresenceTimer){ clearInterval(rkPresenceTimer); rkPresenceTimer=null; }
    if(rkHeartbeatTimer){ clearInterval(rkHeartbeatTimer); rkHeartbeatTimer=null; }
    if(rkRetryTimer){ clearInterval(rkRetryTimer); rkRetryTimer=null; }
    if(rkBotFallbackTimer){ clearTimeout(rkBotFallbackTimer); rkBotFallbackTimer=null; }
    if(rkBotActionTimer){ clearInterval(rkBotActionTimer); rkBotActionTimer=null; }
    rkVsBot=false;
    rkRoomRef=null; rkRoomId=null; rkMyRole=null; rkOppUid=null; rkOppName=''; rkUpdateOppLabel();
    rkCountdownFired=false; rkResultShown=false;
    rkMyHits=0; rkOppHits=0; rkMyLane=1; rkOppLane=1;
    rkProjectiles.forEach(p=>{ const el=document.getElementById('proj_'+p.id); if(el) el.remove(); });
    rkProjectiles=[]; rkProcessedLaunchIds=new Set();
  }

  rkOpenBtn.addEventListener('click', ()=>{
    rkMenuStatus.textContent='';
    showScreen(rkMenuScreen);
    rkLoadMyRP(rkUpdateMenuBadge);
  });
  rkMenuBackBtn.addEventListener('click', ()=>{ showScreen(vsMenuScreen); });

  const RK_MATCH_RP_RANGE = 200;

  function rkFreshCandidateIds(snap, excludeId){
    const now=Date.now();
    const ids=[];
    snap.forEach(doc=>{
      if(doc.id===excludeId) return;
      const d = doc.data();
      const lastSeenMs = d.lastSeen && typeof d.lastSeen.toMillis==='function' ? d.lastSeen.toMillis() : 0;
      const fresh = lastSeenMs===0 || (now-lastSeenMs)<15000;
      const hostRP = typeof d.p1RP==='number' ? d.p1RP : rkMyRP;
      const closeRank = Math.abs(hostRP-rkMyRP) <= RK_MATCH_RP_RANGE;
      if(fresh && closeRank) ids.push(doc.id);
    });
    return ids;
  }

  rkRandomBtn.addEventListener('click', ()=>{
    if(!db){ rkMenuStatus.textContent='通信に接続できません'; return; }
    rkLeave();
    rkMenuStatus.textContent = '対戦相手を探しています...';
    rkBotFallbackTimer = setTimeout(()=>{
      rkBotFallbackTimer = null;
      if(rkCountdownFired) return;
      if(rkRetryTimer){ clearInterval(rkRetryTimer); rkRetryTimer=null; }
      rkStopHeartbeat();
      if(rkRoomUnsub){ rkRoomUnsub(); rkRoomUnsub=null; }
      if(rkRoomRef && rkMyRole==='p1'){ rkRoomRef.delete().catch(()=>{}); }
      else if(rkRoomRef && rkMyRole==='p2'){ rkRoomRef.update({p2:null,p2Name:null,status:'waiting'}).catch(()=>{}); }
      rkRoomRef=null; rkRoomId=null;
      rkStartBotMatch();
    }, RK_BOT_FALLBACK_MS);
    rkLoadMyRP(()=>{
      db.collection('rank_rooms').where('status','==','waiting').limit(20).get().then(snap=>{
        const cands = rkFreshCandidateIds(snap);
        if(cands.length>0) rkTryClaim(cands,0);
        else rkCreateRoom();
      }).catch(e=>{ console.error(e); rkMenuStatus.textContent='マッチングに失敗しました'; });
    });
  });

  function rkTryClaim(cands, idx){
    if(idx>=cands.length){ rkCreateRoom(); return; }
    const ref = db.collection('rank_rooms').doc(cands[idx]);
    db.runTransaction(t=>t.get(ref).then(doc=>{
      if(!doc.exists || doc.data().p2) throw new Error('taken');
      t.update(ref, {p2:userId, p2Name:ensureUsername(), status:'ready'});
    })).then(()=>{
      rkMyRole='p2'; rkRoomId=cands[idx]; rkRoomRef=ref;
      showScreen(rkWaitScreen);
      rkWatchRoom();
    }).catch(()=>rkTryClaim(cands, idx+1));
  }

  function rkCreateRoom(){
    rkMyRole='p1';
    rkRoomId = genRoomCode();
    rkRoomRef = db.collection('rank_rooms').doc(rkRoomId);
    const seed = Math.floor(Math.random()*1e9);
    rkRoomRef.set({
      p1:userId, p1Name:ensureUsername(), p2:null, p2Name:null,
      status:'waiting', seed:seed, p1RP: rkMyRP,
      p1Lane:1, p2Lane:1, p1Hits:0, p2Hits:0, launches:[],
      winnerUid:null,
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      lastSeen: firebase.firestore.FieldValue.serverTimestamp()
    }).then(()=>{
      showScreen(rkWaitScreen);
      rkWatchRoom();
      rkStartHostHeartbeat();
      let tries=0;
      rkRetryTimer = setInterval(()=>{
        tries++;
        if(tries>5 || rkCountdownFired){ clearInterval(rkRetryTimer); rkRetryTimer=null; return; }
        db.collection('rank_rooms').where('status','==','waiting').limit(20).get().then(snap=>{
          const others = rkFreshCandidateIds(snap, rkRoomId);
          if(others.length>0 && !rkCountdownFired){
            clearInterval(rkRetryTimer); rkRetryTimer=null;
            rkStopHeartbeat();
            const old = rkRoomRef;
            if(rkRoomUnsub){ rkRoomUnsub(); rkRoomUnsub=null; }
            old.delete().catch(()=>{});
            rkTryClaim(others, 0);
          }
        }).catch(()=>{});
      }, 3000);
    }).catch(e=>{ console.error(e); rkMenuStatus.textContent='マッチングに失敗しました'; });
  }

  function rkStartHostHeartbeat(){
    rkStopHeartbeat();
    rkHeartbeatTimer = setInterval(()=>{
      if(!rkRoomRef || rkCountdownFired || rkMyRole!=='p1'){ rkStopHeartbeat(); return; }
      rkRoomRef.update({lastSeen: firebase.firestore.FieldValue.serverTimestamp()}).catch(()=>{});
    }, 5000);
  }
  function rkStopHeartbeat(){ if(rkHeartbeatTimer){ clearInterval(rkHeartbeatTimer); rkHeartbeatTimer=null; } }

  rkCancelBtn.addEventListener('click', ()=>{
    if(rkRoomRef){
      if(rkMyRole==='p1'){ rkRoomRef.delete().catch(()=>{}); }
      else { rkRoomRef.update({p2:null, p2Name:null, status:'waiting'}).catch(()=>{}); }
    }
    rkLeave();
    showScreen(rkMenuScreen);
  });

  function rkWatchRoom(){
    rkRoomUnsub = rkRoomRef.onSnapshot(snap=>{
      if(!snap.exists){
        if(!rkResultShown){
          rkMenuStatus.textContent='ルームが閉じられました';
          rkLeave();
          showScreen(rkMenuScreen);
        }
        return;
      }
      rkHandleUpdate(snap.data());
    }, err=>console.error('rank room error', err));
  }

  function rkHandleUpdate(d){
    if(!rkOppUid && d.p1 && d.p2){ rkOppUid = rkMyRole==='p1' ? d.p2 : d.p1; }
    const oppNameFromDoc = rkMyRole==='p1' ? d.p2Name : d.p1Name;
    if(oppNameFromDoc && oppNameFromDoc !== rkOppName){
      rkOppName = oppNameFromDoc;
      rkUpdateOppLabel();
    }

    const oppLaneField = rkMyRole==='p1' ? 'p2Lane' : 'p1Lane';
    if(typeof d[oppLaneField]==='number'){
      rkOppLane = d[oppLaneField];
      if(rkRunning) rkRenderOppLane();
    }
    const oppHitsField = rkMyRole==='p1' ? 'p2Hits' : 'p1Hits';
    if(typeof d[oppHitsField]==='number' && d[oppHitsField]!==rkOppHits){
      rkOppHits = d[oppHitsField];
      if(rkRunning) rkUpdateHearts();
    }

    if(d.p2 && !rkCountdownFired){
      rkCountdownFired = true;
      rkStopHeartbeat();
      if(rkRetryTimer){ clearInterval(rkRetryTimer); rkRetryTimer=null; }
      if(rkBotFallbackTimer){ clearTimeout(rkBotFallbackTimer); rkBotFallbackTimer=null; }
      rkStartCountdown(d.seed);
    }

    if(rkRunning) rkProcessLaunches(d.launches||[]);

    if(rkRunning && !rkResultShown){
      const oppSeenField = rkMyRole==='p1' ? 'p2Seen' : 'p1Seen';
      const seenTs = d[oppSeenField];
      if(seenTs && typeof seenTs.toMillis==='function'){
        const ageMs = Date.now()-seenTs.toMillis();
        if(ageMs > 10000){
          rkResultShown = true;
          if(rkRoomRef) rkRoomRef.update({status:'ended', winnerUid:userId}).catch(()=>{});
          rkShowResult(true);
          return;
        }
      }
    }

    if(d.status==='ended' && !rkResultShown){
      rkResultShown = true;
      rkShowResult(d.winnerUid===userId);
    }
  }

  function rkStartCountdown(seed){
    showScreen(null);
    rkWaitScreen.style.display='none';
    rkCountdownScreen.style.display='flex';
    let n=3;
    rkCountdownNum.textContent=n;
    const iv = setInterval(()=>{
      n--;
      if(n>0){ rkCountdownNum.textContent=n; }
      else if(n===0){ rkCountdownNum.textContent='START'; }
      else{ clearInterval(iv); rkCountdownScreen.style.display='none'; rkBeginMatch(); }
    }, 700);
  }

  function rkStartBotMatch(){
    rkVsBot = true;
    rkMyRole = 'p1';
    rkOppUid = 'bot';
    rkOppName = RK_BOT_NAMES[Math.floor(Math.random()*RK_BOT_NAMES.length)];
    rkUpdateOppLabel();
    showScreen(null);
    rkWaitScreen.style.display='none';
    rkCountdownScreen.style.display='flex';
    let n=3;
    rkCountdownNum.textContent=n;
    const iv = setInterval(()=>{
      n--;
      if(n>0){ rkCountdownNum.textContent=n; }
      else if(n===0){ rkCountdownNum.textContent='START'; }
      else{ clearInterval(iv); rkCountdownScreen.style.display='none'; rkBeginMatch(); }
    }, 700);
  }

  function rkBotDifficulty(){
    // scales with the player's current rank: higher rank = faster, more accurate bot.
    // overall baseline was raised across every rank so bots are a real threat from bronze up.
    const idx = rkRankIndexForRP(rkMyRP); // 0 (bronze IV) .. 23 (overlord)
    const t = idx / (RK_TIERS.length-1); // 0..1
    return {
      interval: Math.round(620 - t*370),   // 620ms at bronze -> ~250ms at overlord
      aimChance: 0.68 + t*0.28,            // 0.68 -> 0.96
      wanderChance: 0.45 - t*0.25          // 0.45 -> 0.20 (less random, more focused at high rank)
    };
  }

  function rkBotAction(){
    if(!rkRunning || !rkVsBot || rkResultShown) return;
    const diff = rkBotDifficulty();
    // fairly strong: often snaps onto the player's current lane right before firing
    // (a well-aimed shot), otherwise repositions somewhat randomly. Both the aim
    // accuracy and the fire rate get tougher as the player's rank climbs.
    if(Math.random() < diff.aimChance){
      rkOppLane = rkMyLane;
    } else if(Math.random() < diff.wanderChance){
      rkOppLane = Math.floor(Math.random()*LANES.length);
    }
    rkRenderOppLane();
    const id = 'bot_'+Date.now()+'_'+Math.floor(Math.random()*1000);
    rkProjectiles.push({id, ownerUid:'bot', lane: rkOppLane, bornAt: performance.now(), forMe:true});
    rkSpawnProjEl(id, rkOppLane, true);
  }

  function rkUpdateOppLabel(){
    rkOppNameLabel.textContent = rkOppName || '相手';
  }
  function rkRenderMyLane(){ rkMyDot.style.left = LANES[rkMyLane]+'%'; }
  function rkRenderOppLane(){ rkOppDot.style.left = LANES[rkOppLane]+'%'; }
  function rkPipsHtml(hits, color){
    const remain = Math.max(0, 2-hits);
    let s = '';
    for(let i=0;i<remain;i++) s += '<span style="color:'+color+';">●</span>';
    for(let i=0;i<hits;i++) s += '<span style="color:rgba(255,255,255,0.22);">●</span>';
    return s;
  }
  function rkUpdateHearts(){
    rkMyHeartsEl.innerHTML = rkPipsHtml(rkMyHits, '#ff5050');
    rkOppHeartsEl.innerHTML = rkPipsHtml(rkOppHits, '#5090ff');
  }

  function rkSetMyLane(idx){
    rkMyLane = Math.max(0, Math.min(LANES.length-1, idx));
    rkRenderMyLane();
    if(rkRoomRef){
      const field = rkMyRole==='p1' ? 'p1Lane' : 'p2Lane';
      rkRoomRef.update({[field]: rkMyLane}).catch(()=>{});
    }
  }
  function rkMoveLeft(){ if(rkRunning) rkSetMyLane(rkMyLane-1); }
  function rkMoveRight(){ if(rkRunning) rkSetMyLane(rkMyLane+1); }

  rkMyZone.addEventListener('pointerdown', (e)=>{
    e.preventDefault();
    const rect = rkMyZone.getBoundingClientRect();
    const relX = e.clientX - rect.left;
    if(relX < rect.width/2) rkMoveLeft(); else rkMoveRight();
  });

  function rkFire(){
    if(!rkRunning) return;
    const now = performance.now();
    if(now - rkLastFireAt < RK_FIRE_COOLDOWN) return;
    rkLastFireAt = now;
    const id = userId+'_'+Date.now()+'_'+Math.floor(Math.random()*1000);
    rkProjectiles.push({id, ownerUid:userId, lane:rkMyLane, bornAt:performance.now(), forMe:false});
    rkProcessedLaunchIds.add(id);
    rkSpawnProjEl(id, rkMyLane, false);
    if(rkRoomRef){
      rkRoomRef.update({launches: firebase.firestore.FieldValue.arrayUnion({id, ownerUid:userId, lane:rkMyLane, t:Date.now()})}).catch(()=>{});
    }
  }
  rkOppZone.addEventListener('pointerdown', (e)=>{ e.preventDefault(); rkFire(); });

  function rkProcessLaunches(launches){
    launches.forEach(ev=>{
      if(rkProcessedLaunchIds.has(ev.id)) return;
      rkProcessedLaunchIds.add(ev.id);
      if(ev.ownerUid===userId) return;
      const ageMs = Date.now()-ev.t;
      // generous window: a slow/late Firestore delivery (network blip, tab
      // backgrounded briefly, etc.) used to silently drop the shot entirely -
      // no visual AND no hit resolution. Now it still registers; if it's
      // already past its travel time it resolves on the very next frame.
      if(ageMs > 8000 || ageMs < -2000) return;
      rkProjectiles.push({id:ev.id, ownerUid:ev.ownerUid, lane:ev.lane, bornAt:performance.now()-ageMs, forMe:true});
      rkSpawnProjEl(ev.id, ev.lane, true);
    });
  }

  function rkSpawnProjEl(id, lane, forMe){
    const el = document.createElement('img');
    el.id = 'proj_'+id;
    el.className = 'rkProj';
    el.src = 'data:image/png;base64,';
    el.style.left = LANES[lane]+'%';
    el.style.top = forMe ? '9%' : '91%';
    rkProjLayer.appendChild(el);
  }

  function rkUpdateProjectiles(now){
    for(let i=rkProjectiles.length-1;i>=0;i--){
      const p = rkProjectiles[i];
      const age = now - p.bornAt;
      const t = Math.min(1, age/RK_TRAVEL_MS);
      const el = document.getElementById('proj_'+p.id);
      if(el){
        const yPct = p.forMe ? (9 + t*82) : (91 - t*82);
        el.style.top = yPct+'%';
        el.style.left = LANES[p.lane]+'%';
      }
      if(age >= RK_TRAVEL_MS){
        if(p.forMe && p.lane===rkMyLane && rkRunning && !rkResultShown){
          rkOnSelfHit();
        }
        if(rkVsBot && !p.forMe && p.ownerUid===userId && p.lane===rkOppLane && rkRunning && !rkResultShown){
          rkOnBotHit();
        }
        if(el) el.remove();
        rkProjectiles.splice(i,1);
      }
    }
  }

  function rkOnBotHit(){
    rkOppHits++;
    rkUpdateHearts();
    if(rkOppHits>=2 && !rkResultShown){
      rkResultShown = true;
      rkShowResult(true);
    }
  }

  function rkOnSelfHit(){
    rkMyHits++;
    rkUpdateHearts();
    const field = rkMyRole==='p1' ? {p1Hits:rkMyHits} : {p2Hits:rkMyHits};
    if(rkRoomRef) rkRoomRef.update(field).catch(()=>{});
    if(rkMyHits>=2 && !rkResultShown){
      rkResultShown = true;
      if(rkRoomRef) rkRoomRef.update({status:'ended', winnerUid: rkOppUid||null}).catch(()=>{});
      rkShowResult(false);
    }
  }

  function rkStartPresenceHeartbeat(){
    if(rkPresenceTimer) clearInterval(rkPresenceTimer);
    rkPresenceTimer = setInterval(()=>{
      if(!rkRoomRef || !rkRunning) return;
      const field = rkMyRole==='p1' ? 'p1Seen' : 'p2Seen';
      rkRoomRef.update({[field]: firebase.firestore.FieldValue.serverTimestamp()}).catch(()=>{});
    }, 4000);
  }

  function rkBeginMatch(){
    rkRunning = true;
    rkMyHits = 0; rkOppHits = 0; rkResultShown = false;
    rkMyLane = 1; rkOppLane = 1;
    rkProjectiles = []; rkProcessedLaunchIds = new Set();
    rkProjLayer.innerHTML = '';
    rkUpdateHearts();
    showScreen(rkGameScreen);
    rkRenderMyLane(); rkRenderOppLane();
    if(rkVsBot){
      if(rkBotActionTimer) clearInterval(rkBotActionTimer);
      rkBotActionTimer = setInterval(rkBotAction, rkBotDifficulty().interval);
    } else {
      rkStartPresenceHeartbeat();
    }
    function frame(now){
      if(!rkRunning) return;
      rkUpdateProjectiles(now);
      rkAnimHandle = requestAnimationFrame(frame);
    }
    rkAnimHandle = requestAnimationFrame(frame);
  }

  function rkShowResult(won){
    rkRunning = false;
    if(rkAnimHandle){ cancelAnimationFrame(rkAnimHandle); rkAnimHandle=null; }
    if(rkPresenceTimer){ clearInterval(rkPresenceTimer); rkPresenceTimer=null; }
    const delta = won ? RK_WIN_RP : RK_LOSE_RP;
    const newRP = Math.max(0, rkMyRP+delta);
    rkSaveMyRP(newRP);
    const info = rkRankInfo(newRP);
    rkResultTitle.textContent = won ? '勝ち！' : '負け...';
    rkSetIconEl(rkResultIconImg, info.idx, 110);
    rkResultRankName.textContent = info.name;
    rkResultRPChange.innerHTML = (delta>=0?'+':'')+delta+' RP (合計 '+newRP+' RP)';
    rkResultRPChange.style.color = won ? '#5fdc7a' : '#ff6a4d';
    showScreen(rkResultScreen);
    if(rkMyRole==='p1' && rkRoomRef){
      const ref = rkRoomRef;
      setTimeout(()=>{ ref.delete().catch(()=>{}); }, 4000);
    }
    rkLeave();
  }

  rkResultHomeBtn.addEventListener('click', ()=>{
    showScreen(startScreen);
  });

  setInterval(()=>{
    if(rkWaitScreen.style.display==='flex'){
      rkWaitDotN = (rkWaitDotN+1)%4;
      rkWaitDots.textContent = '.'.repeat(rkWaitDotN+1);
    }
  }, 500);

  window.addEventListener('pagehide', ()=>{
    if(rkRunning && !rkResultShown && rkRoomRef && rkOppUid){
      rkRoomRef.update({status:'ended', winnerUid: rkOppUid}).catch(()=>{});
    }
  });
  // ===============================================================

  // ================= gamepad support (Switch / PS / Xbox etc.) =================
  // Lane movement: D-pad left/right or the left stick. Fire (rank match only): ZR
  // (the "standard" browser gamepad mapping puts the right trigger - ZR on a
  // Switch controller, R2 on PlayStation, RT on Xbox - at button index 7).
  let gpPrevLeft = false, gpPrevRight = false, gpPrevFire = false;
  const GP_AXIS_DEADZONE = 0.5;

  function gamepadMoveLeft(){
    if(rkRunning){ rkMoveLeft(); return; }
    if(running && !gameOver){ moveLeft(); return; }
  }
  function gamepadMoveRight(){
    if(rkRunning){ rkMoveRight(); return; }
    if(running && !gameOver){ moveRight(); return; }
  }
  function gamepadFire(){
    if(rkRunning){ rkFire(); }
  }

  function pollGamepad(){
    const pads = navigator.getGamepads ? navigator.getGamepads() : [];
    let pad = null;
    for(let i=0;i<pads.length;i++){ if(pads[i]){ pad = pads[i]; break; } }
    if(pad){
      const dpadLeft = !!(pad.buttons[14] && pad.buttons[14].pressed);
      const dpadRight = !!(pad.buttons[15] && pad.buttons[15].pressed);
      const axisX = pad.axes[0] || 0;
      const curLeft = dpadLeft || axisX < -GP_AXIS_DEADZONE;
      const curRight = dpadRight || axisX > GP_AXIS_DEADZONE;
      const curFire = !!(pad.buttons[7] && pad.buttons[7].pressed);

      if(curLeft && !gpPrevLeft) gamepadMoveLeft();
      if(curRight && !gpPrevRight) gamepadMoveRight();
      if(curFire && !gpPrevFire) gamepadFire();

      gpPrevLeft = curLeft; gpPrevRight = curRight; gpPrevFire = curFire;
    }
    requestAnimationFrame(pollGamepad);
  }
  requestAnimationFrame(pollGamepad);
  // ===============================================================

})();
</script>
</body>
</html>
